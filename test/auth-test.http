  "email": "{{user1Email}}",
  "password": "{{password}}",
  "firstName": "John",
  "lastName": "Duplicate",
  "merchantId": "{{merchantId}}"
}

### 1.3 ❌ Register with Invalid Email (Should Fail - 400)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "invalid-email",
  "password": "{{password}}",
  "firstName": "Invalid",
  "lastName": "Email",
  "merchantId": "{{merchantId}}"
}

### 1.4 ❌ Register with Weak Password (Should Fail - 400)
